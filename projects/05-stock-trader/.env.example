# === 한국투자증권 API (https://apiportal.koreainvestment.com) ===
KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here
KIS_ACCOUNT_NO=12345678-01
KIS_IS_PAPER=true

# === 트레이딩 모드 (이중 안전장치) ===
# paper: 페이퍼 트레이딩 (기본값, 추천)
# live: 실전 매매 (LIVE_TRADING_CONFIRMED도 true여야 함)
TRADING_MODE=paper
LIVE_TRADING_CONFIRMED=false

# === 초기 자본 (원) ===
# 자본 규모에 따라 매매 설정이 자동 조정됩니다
# ~300만원: 최대 4종목, 종목당 30%
# ~1000만원: 최대 8종목, 종목당 20%
# 1000만원+: 최대 15종목, 종목당 10%
INITIAL_CAPITAL=2000000

# === 안전 한도 (원) ===
# 미설정 시 초기 자본의 3%/7%로 자동 계산
# MAX_DAILY_LOSS_KRW=60000
# MAX_WEEKLY_LOSS_KRW=140000

# === OpenAI API (뉴스 감성 분석 고급 기능) ===
OPENAI_API_KEY=your_openai_key_here

# === Telegram 알림 (https://t.me/BotFather) ===
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# === Discord 알림 (v3.7) ===
DISCORD_WEBHOOK_URL=

# === Email 알림 (v3.7) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# === 로깅 ===
LOG_LEVEL=INFO
