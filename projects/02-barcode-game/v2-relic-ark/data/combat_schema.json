{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "배치 방어 — 생물·대응 도구 계약 (COMBAT_AND_DEFENSE.md)",
  "_정본": "수치의 정본은 data/balance/defense.json·threats.json(밸런스)이고 engine/combat.py 가 읽는다. 생물 명단·문장의 정본은 data/creatures.json(시나리오). 이 스키마는 문장 계약이다.",
  "_금지": "실제 종교·경전·인물·지명 이름 금지(00_COMMON §5). 생물은 돔 사람들이 부르는 이름만 쓴다. 문어는 어떤 매체에서도 발화하지 않는다(DECISIONS 2026-09-27) — 문어 문장에 따옴표·의성어·생각자막을 넣지 않는다.",
  "type": "object",
  "properties": {
    "creatures": {
      "type": "array",
      "description": "바깥에서 오는 것들. 종마다 막는 방법이 다르다(§4).",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "how",
          "sound",
          "silhouette",
          "contact"
        ],
        "properties": {
          "id": {
            "enum": [
              "swarm",
              "longneck",
              "warden",
              "claws",
              "mirror_eye",
              "straight_one",
              "lid",
              "needle",
              "big_maw",
              "follower",
              "upper_child",
              "octopus",
              "shade",
              "far_cry"
            ],
            "description": "data/creatures.json 14종. 위협 11 + 위협 아님 3(문어·그늘·먼 울음)"
          },
          "name": {
            "type": "string",
            "description": "화면에 보이는 이름. 학명·종명 금지"
          },
          "zone": {
            "type": "string",
            "enum": [
              "광층",
              "박광층",
              "무광층",
              "무광층 경계",
              "해구",
              "돔 안팎"
            ]
          },
          "threat": {
            "type": "boolean",
            "description": "false 면 판정이 없다(문어). 기본 true"
          },
          "how": {
            "type": "string",
            "description": "막는 법 한 줄. 플레이어가 읽는 유일한 설명"
          },
          "sound": {
            "type": "string",
            "description": "예고 1단계. 어느 방인지 **아직 모른다**"
          },
          "silhouette": {
            "type": "string",
            "description": "예고 2단계. 특정 방 쪽으로 다가온다"
          },
          "contact": {
            "type": "string",
            "description": "예고 3단계. 접촉 직전의 한 줄"
          },
          "lines": {
            "type": "object",
            "description": "결과별 문장. 없으면 engine/combat.outcome_line 의 초안을 쓴다",
            "properties": {
              "held": {
                "type": "string"
              },
              "scarred": {
                "type": "string"
              },
              "breached": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "description": "대응 도구 일곱(§6.5). **무기가 아니다** — 등불·그물·봉합 패치·소리 가리개. 이름을 무기로 부르지 않는다(DECISIONS 2026-10-01).",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "does"
        ],
        "properties": {
          "id": {
            "enum": [
              "patch",
              "shutter",
              "lure_lamp",
              "hush",
              "beacon",
              "long_net",
              "brace"
            ]
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "consumable",
              "install",
              "durable",
              "permanent"
            ],
            "description": "소모 / 설치 / 내구 / 영구. 설치·내구·영구는 방에 붙는다"
          },
          "does": {
            "type": "string",
            "description": "하는 일 한 줄"
          },
          "flavor": {
            "type": "string",
            "description": "공방에서 만들 때 한 줄(선택). 유물이 무엇이었는지 기억하는 문장"
          }
        }
      }
    }
  },
  "_판정공식": {
    "설명": "난수가 한 톨도 없다(02_DEV D6). 관문은 점수가 아니라 분기다(BALANCE §2-1, S10-C).",
    "score": "방 바탕[레벨 1.0/1.5/2.0] + Σ사람(0.5+0.1×담, 부상 ×0.5) + Σ역할 친화(강 1.5/약 0.75, defense.json role_affinity) + Σ각인 일치 1.5 + min(Σ도구, 3.0)",
    "need": "threats.json need_by_grade[등급] + creature_offset[생물] + severity. 등급은 거점 깊이로만 정해진다",
    "판정": "관문 통과: margin≥0 막았다 / ≥−4.5 금 / 그 밖 상실. 관문 실패: ≥−1.0 금 / 그 밖 상실(막기 불가). 상실 보호: 등급1 전면, 등급2 사람 있는 방. 문지기(quiet) 관문 통과 = passed(들키지 않았다)",
    "관문": {
      "people": "작은 떼 — 사람 수 ≥ 2+세기 (정원+도구 칸으로 상한)",
      "lights_off": "긴목",
      "quiet": "문지기",
      "all_inside": "손톱 무리",
      "light_elsewhere": "거울눈 — 이 방 불은 켠 채 + 반대쪽 유인 등불/행동",
      "cloud_water": "곧은치 — 행동",
      "stand_still": "덮개 — 습격 시작 뒤 이동 0회",
      "make_way": "바늘 — 행동",
      "feed": "큰 입 — 행동",
      "return_it": "따라온 것 — 행동",
      "guide_up": "윗물 아이 — 행동",
      "none": "문어·그늘·먼 울음"
    }
  },
  "_방정원": {
    "pantry": 4,
    "well": 2,
    "infirmary": 3,
    "library": 2,
    "workshop": 4,
    "_default": 3,
    "설명": "방 크기별 2~4명(§9). 넘으면 배치가 거부된다. 배치되지 않은 사람은 홀에 모인다"
  }
}