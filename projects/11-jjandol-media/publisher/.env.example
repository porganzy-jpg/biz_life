# publisher/.env 로 복사해서 채우세요. .env 는 절대 커밋하지 마세요.

# ── 인스타그램 (비즈니스/크리에이터 계정 + 페이스북 페이지 연결 필요) ──
IG_USER_ID=
IG_ACCESS_TOKEN=

# 릴스는 파일 업로드가 안 되고 공개 URL만 받습니다.
# 영상을 올려둘 정적 호스팅의 베이스 주소. 없으면 인스타는 수동 업로드로 두세요.
PUBLIC_MEDIA_BASE=

# ── 유튜브 ──
# 토큰이 아니라 파일로 관리합니다:
#   publisher/client_secret.json  (Google Cloud Console → 데스크톱 앱 OAuth 클라이언트)
#   publisher/token.json          (최초 실행 시 자동 생성)
