# HomeFinder - 마지막 집 찾기 설정
HOMEFINDER_PORT=8006
DATABASE_URL=sqlite:///homefinder.db

# 공공데이터포털 (data.go.kr 무료 신청)
PUBLIC_DATA_API_KEY=

# 카카오맵 (developers.kakao.com 무료)
KAKAO_REST_API_KEY=

# 텔레그램 봇 (BotFather 무료)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 예산 범위 (원)
BUDGET_MIN_KRW=800000000
BUDGET_MAX_KRW=1500000000

# 대상 지역
TARGET_DISTRICTS=마포구,용산구,성동구,광진구,영등포구,동작구,강동구,은평구,강서구,노원구
TARGET_CITIES=서울특별시,하남시,과천시,성남시,광명시,고양시,구리시,남양주시

# 스크래퍼 설정
SCRAPER_ENABLED=true
SCRAPER_INTERVAL_HOURS=24
SCRAPER_TARGET_DISTRICTS=
SCRAPER_RATE_LIMIT_SEC=2

# 채점 가중치
SCORE_WEIGHT_LOCATION=0.35
SCORE_WEIGHT_PRICE=0.25
SCORE_WEIGHT_PROPERTY=0.20
SCORE_WEIGHT_AREA=0.20

# 로깅
LOG_LEVEL=INFO
